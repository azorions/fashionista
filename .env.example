# Copy to .env.local and fill in. .env.local is gitignored.
#
# ONLY these two may ever reach the app bundle. Expo inlines every
# EXPO_PUBLIC_* variable into the JavaScript IN PLAIN TEXT — anyone who
# unzips the APK can read them. That is fine for these two and ONLY these two:
# the publishable key is designed to be public and is bounded by RLS.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# EVERYTHING BELOW IS SERVER-SIDE ONLY. Never prefix these with EXPO_PUBLIC_,
# never put them in this app's bundle. Set them with:
#     npx supabase secrets set NAME=value
#
# SUPABASE_SECRET_KEY   sb_secret_...   bypasses RLS entirely
# REPLICATE_API_TOKEN   milestone 1 cutout provider (free signup credits)
# FAL_KEY               optional paid cutout provider, swap via CUTOUT_PROVIDER
# CUTOUT_PROVIDER       'replicate' | 'fal' | 'selfhost'
# ANTHROPIC_API_KEY     milestone 3 auto-tagger. Not needed for milestone 1.
